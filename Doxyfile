# Документация из комментариев в src/ и README.md. Указаны только отличия от
# умолчаний Doxygen; полный список параметров выводит `doxygen -g`.
PROJECT_NAME           = defi-risk-engine
PROJECT_BRIEF          = "Риск ликвидации кредитной позиции с плечом в DeFi"
# Doxygen создаёт только одну недостающую папку: build, а HTML в её подпапке docs.
OUTPUT_DIRECTORY       = build
HTML_OUTPUT            = docs
OUTPUT_LANGUAGE        = Russian
INPUT                  = README.md src
USE_MDFILE_AS_MAINPAGE = README.md
GENERATE_LATEX         = NO
# Графы рисует Graphviz (dot), его нет среди зависимостей проекта.
HAVE_DOT               = NO
QUIET                  = YES
